# Copy to .env and fill in. Never commit .env.

# Explanation mode: template | local | api
# The dashboard Settings screen saves to config.local.json (gitignored, mode 600),
# which overrides these values.
EXPLAIN_MODE=template

# OpenAI-compatible endpoint (used by both local and api modes)
# Local example (Ollama): http://localhost:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Seconds before falling back to template explanations
LLM_TIMEOUT=3

# Force simulated measurements and faults (1 = on)
SIM_MODE=1

# Real measurements and faults run inside a network namespace (scripts/netns_up.sh).
# Faults only ever touch the host end of its veth pair, never the main interface.
STRATA_NETNS=strata
STRATA_VETH_HOST=strata-host
STRATA_VETH_NS=strata-ns
STRATA_GW_IP=10.200.0.1
# Resolver written to /etc/netns/strata/resolv.conf (the "primary" DNS in features).
# Keep a single entry: training data was collected with exactly one.
STRATA_DNS_SERVERS=1.1.1.1

# Collector probe targets
PING_TARGET=8.8.8.8
DNS_ALT=9.9.9.9
DNS_QUERY_NAMES=example.com,wikipedia.org,github.com,cloudflare.com,naver.com
THROUGHPUT_URL=https://speed.cloudflare.com/__down?bytes=1000000

# --- Diagnosis history (optional) --------------------------------------------------
# Supabase project URL and a NEW-style secret key (Settings > API Keys > Secret keys).
# Leave both empty to keep history local only; realtime diagnosis works either way.
# Only sb_secret_... keys are accepted: legacy anon/service_role JWTs (eyJ...) and
# publishable keys are refused. The key stays on the server; never put it in web/.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Agent identity in the history (defaults: the namespace name, region "default").
# For several agents on one host, set these per process on the command line instead.
STRATA_AGENT_ID=
STRATA_AGENT_NAME=
STRATA_REGION=
# One stored row per this many seconds per agent (plus every label change).
STRATA_RECORD_SECONDS=10
